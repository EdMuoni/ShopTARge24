@model IEnumerable<ShopTARge24.Models.Spaceships.SpaceshipIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="create" asp-controller="Spaceships" type="submit" class="btn btn-primary" id="CreateButtonAction">Create</a>
</div>

<div class="h1">
    Spaceships
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Built Date</th>
                <th scope="col">Crew</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
                {
                    <tr>
                        <td>@rowNumber</td>
                    <td id="testIdName_I">@spaceship.Name</td>
                    <td id="testIdClassification_I">@spaceship.Classification</td>
                    <td id="testIdBuiltDate_I">@spaceship.BuiltDate</td>
                    <td id="testIdCrew_I">@spaceship.Crew</td>
                        <td>
                        <a asp-action="details" asp-controller="spaceships" asp-route-id="@spaceship.Id" class="btn btn-primary" id="DetailsButtonAction">Details</a>
                        <a asp-action="update" asp-controller="spaceships" asp-route-id="@spaceship.Id" class="btn btn-primary" id="UpdateButtonAction">Update</a>
                        <a asp-action="delete" asp-controller="spaceships" asp-route-id="@spaceship.Id" class="btn btn-outline-danger" id="DeleteButtonAction">Delete</a>
                        </td>
                </tr>
                rowNumber += 1;
            }
        </tbody>
    </table>
</form>
